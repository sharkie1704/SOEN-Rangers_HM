// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  RESTAURANT
  COURIER
  OPERATOR
}

enum CourierStatus {
  OFFLINE
  IDLE
  ASSIGNED
  CARRYING
}

model User {
  id           String   @id @default(uuid())
  name         String
  // Enforcing R-REG-01 with the one role column
  role         Role

  // Authentification
  email        String   @unique
  passwordHash String

  // Customer only
  deliveryLat  Float?
  deliveryLng  Float?

  // Courier only; a CHECK constraint requires courierStatus for couriers (see the require_courier_status migration)
  courierLat    Float?
  courierLng    Float?
  courierStatus CourierStatus?

  // Restaurant staff only (plain string for now; ORD team can turn it into a FK later)
  restaurantId String?

  @@index([role])
}

// ---------- ORD ----------

enum RestaurantStatus {
  OPEN
  PAUSED
  CLOSED
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  PICKED_UP
  DELIVERED
  REJECTED
  CANCELLED
}

enum OrderAction {
  PLACE
  ACCEPT
  REJECT
  CANCEL
  START_PREPARING
  MARK_READY
  PICK_UP
  DELIVER
}

model Restaurant {
  id          String           @id @default(uuid())
  name        String
  category    String
  description String
  imageUrl    String
  status      RestaurantStatus @default(OPEN)
  lat         Float?
  lng         Float?

  menuItems MenuItem[]
  orders    Order[]
}

model MenuItem {
  id           Int        @id @default(autoincrement())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String
  imageUrl     String
  priceCents   Int
  available    Boolean    @default(true)

  @@index([restaurantId])
}

// IDs are taken from the sequences up front (nextOrderId/nextEventId), so the
// domain objects have their IDs before they are saved
model Order {
  id           Int         @id @default(autoincrement())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  // User.id; no FK yet so REG's User model stays untouched
  customerId   String
  status       OrderStatus
  placedAt     DateTime

  lines       OrderLine[]
  events      OrderEvent[]
  assignments Assignment[]

  @@index([restaurantId, status])
  @@index([customerId])
}

// Snapshot of the menu item at order time, so no FK to MenuItem
model OrderLine {
  id             Int    @id @default(autoincrement())
  orderId        Int
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position       Int
  menuItemId     Int
  name           String
  quantity       Int
  unitPriceCents Int

  @@unique([orderId, position])
}

model OrderEvent {
  id         Int         @id @default(autoincrement())
  orderId    Int
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorId    String
  action     OrderAction
  fromStatus OrderStatus
  toStatus   OrderStatus
  reason     String?
  occurredAt DateTime

  @@index([orderId])
}

model MenuItemEvent {
  id         Int      @id @default(autoincrement())
  menuItemId Int
  actorId    String
  available  Boolean
  occurredAt DateTime

  @@index([menuItemId])
}

model RestaurantStatusEvent {
  id           Int              @id @default(autoincrement())
  restaurantId String
  actorId      String
  fromStatus   RestaurantStatus
  toStatus     RestaurantStatus
  occurredAt   DateTime

  @@index([restaurantId])
}

// ---------- DLV ----------

model CourierStatusEvent {
  id         Int           @id @default(autoincrement())
  // User.id; no FK so REG's User model stays untouched
  courierId  String
  actorId    String
  fromStatus CourierStatus
  toStatus   CourierStatus
  occurredAt DateTime

  @@index([courierId])
}

enum AssignmentStatus {
  OFFERED
  ACCEPTED
  DECLINED
  COMPLETED
}

enum AssignmentAction {
  OFFER
  ACCEPT
  DECLINE
  COMPLETE
}

model Assignment {
  id        Int              @id @default(autoincrement())
  orderId   Int
  order     Order            @relation(fields: [orderId], references: [id])
  courierId String
  status    AssignmentStatus

  events AssignmentEvent[]

  @@index([orderId])
  @@index([courierId])
}

model AssignmentEvent {
  id           Int              @id @default(autoincrement())
  assignmentId Int
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  actorId      String
  action       AssignmentAction
  occurredAt   DateTime

  @@index([assignmentId])
}
